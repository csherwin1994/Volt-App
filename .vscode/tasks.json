{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (Debug)",
      "type": "shell",
      "command": "xcodebuild -project Volt.xcodeproj -scheme Volt -destination 'platform=iOS Simulator,name=iPhone 16' -configuration Debug build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$xcodebuild"
    },
    {
      "label": "Build (Release)",
      "type": "shell",
      "command": "xcodebuild -project Volt.xcodeproj -scheme Volt -destination 'platform=iOS Simulator,name=iPhone 16' -configuration Release build",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$xcodebuild"
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "xcodebuild -project Volt.xcodeproj -scheme Volt -destination 'platform=iOS Simulator,name=iPhone 16' test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$xcodebuild"
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "xcodebuild -project Volt.xcodeproj -scheme Volt clean",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
