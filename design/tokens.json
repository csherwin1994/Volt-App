{
  "$description": "Volt design tokens. This file is the single source of truth for colours, spacing and corner radius. After editing, run: python3 design/generate_theme.py",
  "color": {
    "bg": {
      "light": "#F3F3EF",
      "dark": "#111513",
      "css": "--bg",
      "use": "Screen background: soft birch white / night forest"
    },
    "surface": {
      "light": "#FFFFFF",
      "dark": "#191E1C",
      "css": "--surface",
      "use": "Raised content when it must be set apart: inputs, the set table, sheets"
    },
    "surfaceHigh": {
      "light": "#E8E8E2",
      "dark": "#232926",
      "css": "--fill",
      "use": "Input fields, secondary buttons, tags, untrained days"
    },
    "border": {
      "light": "#DCDCD5",
      "dark": "#2B322E",
      "css": "--line",
      "use": "Hairline dividers between rows"
    },
    "borderSubtle": {
      "light": "#E9E9E3",
      "dark": "#1F2522",
      "css": "--line-soft",
      "use": "Faint dividers"
    },
    "ink": {
      "light": "#1B2421",
      "dark": "#E7ECE8",
      "css": "--ink",
      "use": "Primary buttons, selected chips, rest bar (pine ink / pale birch)"
    },
    "onInk": {
      "light": "#F7F7F4",
      "dark": "#111513",
      "css": "--on-ink",
      "use": "Text and icons on ink"
    },
    "accent": {
      "light": "#3A6787",
      "dark": "#8FB5D1",
      "css": "--accent",
      "use": "Fjord blue: timers, links, current week in charts, PR trophy"
    },
    "accentDim": {
      "light": "#E2EBF1",
      "dark": "#1C2933",
      "css": "--accent-soft",
      "use": "Chart area fill, accent tint"
    },
    "label": {
      "light": "#1B2421",
      "dark": "#E7ECE8",
      "css": "--label",
      "use": "Primary text"
    },
    "labelSecondary": {
      "light": "#58615D",
      "dark": "#A3ACA7",
      "css": "--ink-2",
      "use": "Secondary text, section titles"
    },
    "labelTertiary": {
      "light": "#67706B",
      "dark": "#8A938E",
      "css": "--ink-3",
      "use": "Hints, column headers, inactive tabs (4.5:1 on bg and surface)"
    },
    "success": {
      "light": "#3B7A57",
      "dark": "#80C19A",
      "css": "--good",
      "use": "Moss green: Finish button, completed set tick"
    },
    "onSuccess": {
      "light": "#FFFFFF",
      "dark": "#111513",
      "css": "--on-good",
      "use": "Text and icons on success"
    },
    "successSoft": {
      "light": "#E4EFE8",
      "dark": "#17271E",
      "css": "--good-soft",
      "use": "Completed set row background"
    },
    "warning": {
      "light": "#A8541A",
      "dark": "#E8A15C",
      "css": "--warn",
      "use": "Warnings"
    },
    "danger": {
      "light": "#B0362E",
      "dark": "#E68A80",
      "css": "--danger",
      "use": "Lingonberry: discard, delete, sign out"
    },
    "dangerSoft": {
      "light": "#F6E6E3",
      "dark": "#2B1A18",
      "css": "--danger-soft",
      "use": "Destructive button background"
    },
    "bar": {
      "light": "#D6D6CF",
      "dark": "#2E3531",
      "css": "--bar",
      "use": "Chart bars that are not highlighted"
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48,
    "gutter": 24
  },
  "radius": {
    "radiusXs": 10,
    "radiusSm": 12,
    "radius": 20,
    "radiusLg": 24
  },
  "type": {
    "$note": "SF Pro (system font). Sizes in points.",
    "display": {
      "size": 48,
      "weight": "light",
      "use": "Hero numbers: workout clock, rest timer, key stats (tabular digits)"
    },
    "largeTitle": {
      "size": 34,
      "weight": "semibold",
      "use": "Screen titles, greeting"
    },
    "title": {
      "size": 22,
      "weight": "medium",
      "use": "Headline of a suggestion or section lead"
    },
    "body": {
      "size": 16,
      "weight": "medium",
      "use": "Row titles, buttons"
    },
    "callout": {
      "size": 14,
      "weight": "regular",
      "use": "Descriptions"
    },
    "sectionTitle": {
      "size": 13,
      "weight": "semibold",
      "use": "Section titles"
    },
    "caption": {
      "size": 12,
      "weight": "medium",
      "use": "Tags, stat labels"
    },
    "number": {
      "size": 15,
      "weight": "semibold",
      "use": "Weights, reps, timers (tabular digits)"
    }
  }
}
