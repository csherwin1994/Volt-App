{
  "$description": "Volt design tokens. This file is the single source of truth for colours, spacing and corner radius. After editing, run: python3 design/generate_theme.py",
  "color": {
    "bg": {
      "light": "#EFEEE9",
      "dark": "#0F0F0E",
      "css": "--bg",
      "use": "Paper: the screen background"
    },
    "surface": {
      "light": "#FAFAF7",
      "dark": "#191917",
      "css": "--surface",
      "use": "Raised paper: the set table, sheets, input fields"
    },
    "surfaceHigh": {
      "light": "#E3E2DC",
      "dark": "#24241F",
      "css": "--fill",
      "use": "Graphite tint: secondary buttons, empty fields, untrained days"
    },
    "border": {
      "light": "#D3D2CB",
      "dark": "#2E2E2A",
      "css": "--line",
      "use": "Hairline rules between rows and around spec grids"
    },
    "borderSubtle": {
      "light": "#E3E2DC",
      "dark": "#24241F",
      "css": "--line-soft",
      "use": "Faint rules inside grids"
    },
    "ink": {
      "light": "#141413",
      "dark": "#F1F0EA",
      "css": "--ink",
      "use": "Graphite: primary buttons, selected states, the rest bar"
    },
    "onInk": {
      "light": "#FAFAF7",
      "dark": "#0F0F0E",
      "css": "--on-ink",
      "use": "Text and icons on ink"
    },
    "accent": {
      "light": "#E3A33A",
      "dark": "#F0B24A",
      "css": "--accent",
      "use": "Performance Gold, used as a fill: done sets, Finish, PRs, the current week"
    },
    "onAccent": {
      "light": "#141413",
      "dark": "#0F0F0E",
      "css": "--on-accent",
      "use": "Text and icons on gold"
    },
    "accentText": {
      "light": "#8A5B0E",
      "dark": "#F0B24A",
      "css": "--accent-text",
      "use": "Gold as text or a thin line on paper (gold fills are too light for text)"
    },
    "accentDim": {
      "light": "#F5E6C8",
      "dark": "#2E2414",
      "css": "--accent-soft",
      "use": "Gold wash: completed set rows, chart area fills"
    },
    "label": {
      "light": "#141413",
      "dark": "#F1F0EA",
      "css": "--label",
      "use": "Primary text"
    },
    "labelSecondary": {
      "light": "#57564F",
      "dark": "#A8A79F",
      "css": "--ink-2",
      "use": "Secondary text and mono labels"
    },
    "labelTertiary": {
      "light": "#6A6962",
      "dark": "#8D8C85",
      "css": "--ink-3",
      "use": "Hints, column headers, inactive tabs (4.5:1 on bg and surface)"
    },
    "success": {
      "light": "#E3A33A",
      "dark": "#F0B24A",
      "css": "--good",
      "use": "Done: same gold as accent (Finish button, completed tick)"
    },
    "onSuccess": {
      "light": "#141413",
      "dark": "#0F0F0E",
      "css": "--on-good",
      "use": "Text and icons on success"
    },
    "successSoft": {
      "light": "#F5E6C8",
      "dark": "#2E2414",
      "css": "--good-soft",
      "use": "Completed set row background"
    },
    "warning": {
      "light": "#A8541A",
      "dark": "#E8A15C",
      "css": "--warn",
      "use": "Warnings"
    },
    "danger": {
      "light": "#B3261E",
      "dark": "#F08A7E",
      "css": "--danger",
      "use": "Destructive actions only: discard, delete, sign out"
    },
    "dangerSoft": {
      "light": "#F3E1DE",
      "dark": "#2D1916",
      "css": "--danger-soft",
      "use": "Destructive button background"
    },
    "bar": {
      "light": "#CFCEC6",
      "dark": "#34342F",
      "css": "--bar",
      "use": "Chart bars that are not highlighted"
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48,
    "gutter": 20
  },
  "radius": {
    "radiusXs": 2,
    "radiusSm": 2,
    "radius": 0,
    "radiusLg": 0
  },
  "type": {
    "$note": "Schibsted Grotesk for words, Geist Mono for data and labels. Sizes in points; tracking in points.",
    "display": {
      "size": 88,
      "weight": "regular",
      "family": "sans",
      "tracking": -3.5,
      "use": "Hero numerals: workout clock, rest timer, today's top weight"
    },
    "largeTitle": {
      "size": 40,
      "weight": "regular",
      "family": "sans",
      "tracking": -1.4,
      "use": "Screen titles and the greeting"
    },
    "title": {
      "size": 28,
      "weight": "regular",
      "family": "sans",
      "tracking": -0.8,
      "use": "Workout and exercise names"
    },
    "body": {
      "size": 17,
      "weight": "regular",
      "family": "sans",
      "tracking": -0.2,
      "use": "Rows, buttons, descriptions"
    },
    "callout": {
      "size": 15,
      "weight": "regular",
      "family": "sans",
      "tracking": 0,
      "use": "Secondary sentences, form cues"
    },
    "sectionTitle": {
      "size": 11,
      "weight": "medium",
      "family": "mono",
      "tracking": 0.9,
      "use": "UPPERCASE section labels"
    },
    "caption": {
      "size": 11,
      "weight": "regular",
      "family": "mono",
      "tracking": 0.4,
      "use": "Units, column headers, tags"
    },
    "number": {
      "size": 17,
      "weight": "regular",
      "family": "mono",
      "tracking": 0,
      "use": "Weights, reps, targets in tables"
    }
  },
  "fonts": {
    "sans": {
      "family": "Schibsted Grotesk",
      "source": "Google Fonts (SIL Open Font License)",
      "stack": "\"Schibsted Grotesk\", -apple-system, system-ui, sans-serif"
    },
    "mono": {
      "family": "Geist Mono",
      "source": "Google Fonts (SIL Open Font License)",
      "stack": "\"Geist Mono\", ui-monospace, SFMono-Regular, monospace"
    }
  }
}
