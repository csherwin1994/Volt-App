{
  "$description": "Volt design tokens. This file is the single source of truth for colours, spacing and corner radius. After editing, run: python3 design/generate_theme.py",
  "color": {
    "bg": {
      "light": "#F5F6F8",
      "dark": "#0B0C0E",
      "css": "--bg",
      "use": "Screen background"
    },
    "surface": {
      "light": "#FFFFFF",
      "dark": "#16181C",
      "css": "--surface",
      "use": "Cards and list rows"
    },
    "surfaceHigh": {
      "light": "#EEF0F3",
      "dark": "#202329",
      "css": "--fill",
      "use": "Input fields, secondary buttons, tags"
    },
    "border": {
      "light": "#E3E5EA",
      "dark": "#262930",
      "css": "--line",
      "use": "Dividers between rows"
    },
    "borderSubtle": {
      "light": "#EDEFF2",
      "dark": "#1D2024",
      "css": "--line-soft",
      "use": "Faint dividers"
    },
    "ink": {
      "light": "#121418",
      "dark": "#F2F3F5",
      "css": "--ink",
      "use": "Primary buttons, selected chips, rest bar"
    },
    "onInk": {
      "light": "#FFFFFF",
      "dark": "#0B0C0E",
      "css": "--on-ink",
      "use": "Text and icons on ink"
    },
    "accent": {
      "light": "#3352FF",
      "dark": "#7D8DFF",
      "css": "--accent",
      "use": "Timers, links, chart highlight, PR trophy"
    },
    "accentDim": {
      "light": "#EBEEFF",
      "dark": "#1C2142",
      "css": "--accent-soft",
      "use": "Chart area fill"
    },
    "label": {
      "light": "#121418",
      "dark": "#F2F3F5",
      "css": "--label",
      "use": "Primary text"
    },
    "labelSecondary": {
      "light": "#5E6472",
      "dark": "#A3A9B5",
      "css": "--ink-2",
      "use": "Secondary text, section titles"
    },
    "labelTertiary": {
      "light": "#6B717D",
      "dark": "#878D97",
      "css": "--ink-3",
      "use": "Hints, column headers, inactive tabs (4.5:1 on cards and the screen background; placeholder text on input fills is slightly lower)"
    },
    "success": {
      "light": "#15803D",
      "dark": "#3CCB70",
      "css": "--good",
      "use": "Finish button, completed set tick"
    },
    "onSuccess": {
      "light": "#FFFFFF",
      "dark": "#0B0C0E",
      "css": "--on-good",
      "use": "Text and icons on success (white in light mode, near-black in dark mode where success is bright)"
    },
    "successSoft": {
      "light": "#E5F5EB",
      "dark": "#10261A",
      "css": "--good-soft",
      "use": "Completed set row background"
    },
    "warning": {
      "light": "#C2410C",
      "dark": "#FF9F0A",
      "css": "--warn",
      "use": "Warnings"
    },
    "danger": {
      "light": "#C42B1E",
      "dark": "#FF6E61",
      "css": "--danger",
      "use": "Discard, delete, sign out"
    },
    "dangerSoft": {
      "light": "#FDECEA",
      "dark": "#2E1512",
      "css": "--danger-soft",
      "use": "Destructive button background"
    },
    "bar": {
      "light": "#D6DAE2",
      "dark": "#30343C",
      "css": "--bar",
      "use": "Chart bars that are not highlighted"
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48,
    "gutter": 20
  },
  "radius": {
    "radiusXs": 9,
    "radiusSm": 10,
    "radius": 16,
    "radiusLg": 20
  },
  "type": {
    "$note": "SF Pro (system font). Sizes in points.",
    "largeTitle": {
      "size": 32,
      "weight": "bold",
      "use": "Screen titles, greeting"
    },
    "title": {
      "size": 20,
      "weight": "semibold",
      "use": "Card titles (Suggested next)"
    },
    "body": {
      "size": 16,
      "weight": "medium",
      "use": "Row titles, buttons"
    },
    "callout": {
      "size": 14,
      "weight": "regular",
      "use": "Descriptions"
    },
    "sectionTitle": {
      "size": 13,
      "weight": "semibold",
      "use": "Section titles"
    },
    "caption": {
      "size": 12,
      "weight": "medium",
      "use": "Tags, stat labels"
    },
    "number": {
      "size": 15,
      "weight": "semibold",
      "use": "Weights, reps, timers (tabular digits)"
    }
  }
}
